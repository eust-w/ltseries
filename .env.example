PORT=18080
CORS_ALLOWED_ORIGIN=http://localhost:3108

MONGODB_URI=mongodb://127.0.0.1:27019
MONGODB_DB=ltseries
TASK_WORKERS=2
TASK_WORKER_POLL_MS=1000

AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DEFAULT_IMAGE_MODEL=wan2.7-image-pro
DEFAULT_VIDEO_MODEL=wan2.7-i2v

AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_TOKEN_TTL_HOURS=24

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

ASSET_PROVIDER_ENDPOINT=
VIDEO_PROVIDER_ENDPOINT=
AUDIO_PROVIDER_ENDPOINT=
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=600
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:18080
FFMPEG_PATH=ffmpeg

# The frontend proxies /api and /files to BACKEND_URL (see LeriesStudio/.env.example).
